# ============================================================
# iGlamHer environment. Copy to .env.local and fill in. NO REAL SECRETS HERE.
# Server-only secrets (no NEXT_PUBLIC_ prefix) are never exposed to the browser.
# `npm run verify:live` checks these against a real project before deploy.
# ============================================================

# --- environment selector: local | test | staging | production ---
APP_ENV=local

# --- core (REQUIRED for staging/production) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000        # canonical URL; MUST be https:// in staging/prod
NEXT_PUBLIC_SUPABASE_URL=                          # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # Supabase publishable/anon key (client)
SUPABASE_SERVICE_ROLE_KEY=                         # Supabase secret/service-role key (SERVER ONLY)

# --- payments (REQUIRED for staging/production) ---
STRIPE_SECRET_KEY=                                 # sk_test_… / sk_live_…  (SERVER ONLY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=                # pk_test_… / pk_live_…  (client)
STRIPE_WEBHOOK_SECRET=                             # whsec_…  webhook signature (SOURCE OF TRUTH)
# Stripe Connect uses the account's own settings; no client id needed for Express.

# --- OAuth (configured in the Supabase dashboard, not here) ---
# Google & Apple providers: set client id/secret in Supabase → Auth → Providers.

# --- Redis (RECOMMENDED for prod: distributed rate-limit + shared cache) ---
# Upstash REST (serverless-safe). Without these, the app falls back to
# per-instance memory and LOGS reduced protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=                                         # generic marker (checkEnv recommendation)

# --- observability (RECOMMENDED) ---
SENTRY_DSN=                                        # error tracking (SERVER)

# --- messaging (optional; features degrade gracefully) ---
RESEND_API_KEY=                                    # transactional email
TWILIO_ACCOUNT_SID=                                # SMS
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FCM_SERVER_KEY=                                    # Android push
APNS_KEY_ID=                                       # iOS push
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- maps / identity / fraud (optional) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=                   # location / ETA
PERSONA_API_KEY=                                   # ID + selfie verification (or use Stripe Identity)
FINGERPRINT_API_KEY=                               # device fingerprinting for fraud

# --- OpenAI (optional; semantic search upgrade) ---
OPENAI_API_KEY=                                    # embeddings; keyword search is the fallback
